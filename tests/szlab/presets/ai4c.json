{
  "id": "ai4c",
  "title": "szlab 本地调试工具",
  "target_device_id": "AI4C_robot_arm",
  "actions_source": "registry",
  "runtime_config": "runtime_configs/ai4c_runtime.json",
  "default_workflow_name": "szlab_canvas_workflow",
  "default_config": {
    "graph": "__generated__",
    "url": "opc.tcp://jdht1471820.bohrium.tech:50001",
    "timeout": 300,
    "no_subscription": true,
    "show_csv": false
  },
  "path_roots": [
    "tests/szlab",
    "unilabos/devices/workstation/AI4C"
  ],
  "device_graph": {
    "nodes": [
      {
        "id": "AI4C_plc",
        "name": "AI4C_plc",
        "children": [],
        "parent": null,
        "type": "device",
        "class": "AI4C_plc",
        "position": { "x": 0, "y": 0, "z": 0 },
        "config": {
          "url": "${opcua_url}",
          "use_subscription": "${use_subscription}"
        },
        "data": {}
      },
      {
        "id": "AI4C_robot_arm",
        "name": "AI4C_robot_arm",
        "children": [],
        "parent": null,
        "type": "device",
        "class": "AI4C_robot_arm",
        "position": { "x": 120, "y": 0, "z": 0 },
        "config": {
          "plc_device_id": "AI4C_plc"
        },
        "data": {}
      }
    ],
    "links": []
  },
  "actions": [
    {
      "method": "pick_well_plate_from_loading_rack",
      "label": "从上料架取孔板",
      "description": "需要选择上料架 1-8 号位",
      "params": [
        {
          "name": "position",
          "label": "料架位置",
          "type": "integer",
          "min": 1,
          "max": 8,
          "default": 1
        }
      ]
    },
    {
      "method": "place_well_plate_to_pipetting_station",
      "label": "放到移液站",
      "description": "机械臂将孔板放置到移液站",
      "params": []
    },
    {
      "method": "pick_well_plate_from_pipetting_station",
      "label": "从移液站取孔板",
      "description": "机械臂从移液站取回孔板",
      "params": []
    },
    {
      "method": "place_well_plate_to_magnetic_stirrer",
      "label": "放到磁搅",
      "description": "机械臂将孔板放置到磁搅",
      "params": []
    },
    {
      "method": "pick_well_plate_from_magnetic_stirrer",
      "label": "从磁搅取孔板",
      "description": "机械臂从磁搅取回孔板",
      "params": []
    },
    {
      "method": "place_well_plate_to_hplc_station",
      "label": "放到 HPLC",
      "description": "机械臂将孔板放置到 HPLC 站",
      "params": []
    },
    {
      "method": "pick_well_plate_from_hplc_station",
      "label": "从 HPLC 取孔板",
      "description": "机械臂从 HPLC 站取回孔板",
      "params": []
    },
    {
      "method": "place_well_plate_to_unloading_rack",
      "label": "放到下料架",
      "description": "需要选择下料架 1-8 号位",
      "params": [
        {
          "name": "position",
          "label": "料架位置",
          "type": "integer",
          "min": 1,
          "max": 8,
          "default": 1
        }
      ]
    }
  ]
}

{
  "name": "szlab_mixer_pump",
  "rules": [
    {
      "name": "complete S06 solvent addition after params are written",
      "trigger": {
        "node": "S06参数写入完成",
        "value": true,
        "edge": "rising"
      },
      "log_nodes": [
        "S06工艺选择",
        "S06_1号溶液添加量",
        "S06_2号溶液添加量"
      ],
      "actions": [
        {
          "write": {
            "node": "S06加工完成",
            "value": false
          }
        },
        {
          "sleep": 0.5
        },
        {
          "write": {
            "node": "S06加工完成",
            "value": true
          }
        }
      ]
    }
  ]
}

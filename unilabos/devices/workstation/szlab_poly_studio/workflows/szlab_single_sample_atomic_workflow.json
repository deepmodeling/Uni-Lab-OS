{
  "name": "szlab_single_sample_atomic_workflow",
  "rules": [
    {
      "name": "szlab_single_sample_atomic_workflow",
      "trigger": {
        "node": "S02 取 TIP",
        "value": true,
        "edge": "rising"
      },
      "log_nodes": [
        "S02 取 TIP",
        "S09 放料",
        "S02 取 TIP",
        "S09 放料",
        "S10 取试剂瓶",
        "S08 放瓶",
        "S08 开/关盖",
        "S08 取瓶",
        "S09 放料",
        "S07 粉罐扫码盘点",
        "S07 替换粉罐旋转到进料位",
        "任务27：S072取粉罐并放回S071",
        "任务26：S071取粉罐并放到S072",
        "S07 替换粉罐旋转到进料位",
        "任务27：S072取粉罐并放回S071",
        "任务26：S071取粉罐并放到S072",
        "S03 取容器",
        "S072 放料",
        "S07 注粉",
        "S072 取料",
        "S06 放料",
        "S06 泵加液完整流程：烧杯检测 → 液位确认 → 写入工艺参数 → 等待加工完成",
        "S06 取料",
        "S09 放料",
        "执行 S09 烧杯加液：取 TIP、液体瓶取液、烧杯放液、放 TIP",
        "S09 取料",
        "S04 放料",
        "执行 S04 磁搅加工",
        "S03 取容器",
        "S08 放瓶",
        "S08 开/关盖",
        "S04 取料",
        "S05 放料",
        "执行烧杯姿势拍照检测",
        "S05 取料",
        "S08 倒料",
        "S11 放成品",
        "S08 开/关盖",
        "S08 取瓶",
        "S11 放成品"
      ],
      "actions": [
        {
          "action": {
            "index": 1,
            "node": "S02 取 TIP",
            "workflow_node_id": "p01_tip_box_1_pick_s02",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s02",
            "params": {
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 2,
            "node": "S09 放料",
            "workflow_node_id": "p01_tip_box_1_place_s09",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s09",
            "params": {
              "product_type": 1,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 3,
            "node": "S02 取 TIP",
            "workflow_node_id": "p01_tip_box_2_pick_s02",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s02",
            "params": {
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 4,
            "node": "S09 放料",
            "workflow_node_id": "p01_tip_box_2_place_s09",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s09",
            "params": {
              "product_type": 1,
              "position": 2
            }
          }
        },
        {
          "action": {
            "index": 5,
            "node": "S10 取试剂瓶",
            "workflow_node_id": "p03_reagent_pick_s10",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s10",
            "params": {
              "position": 1
            },
            "_comment": "准备顺序第二项：从S10取液体试剂瓶。"
          }
        },
        {
          "action": {
            "index": 6,
            "node": "S08 放瓶",
            "workflow_node_id": "p03_reagent_place_s08",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s08",
            "params": {
              "product_type": 3,
              "position": 2
            },
            "_comment": "将100 mL液体试剂瓶放到S08工位2。"
          }
        },
        {
          "action": {
            "index": 7,
            "node": "S08 开/关盖",
            "workflow_node_id": "p03_reagent_open_s08",
            "device_id": "szlab_s08_cap_station",
            "method": "process_cap",
            "params": {
              "工艺选择": 5,
              "样品ID": [
                101
              ],
              "瓶盖暂存位": 1,
              "超时时间": 300.0
            },
            "_comment": "打开100 mL液体试剂瓶，瓶盖放入暂存位1。"
          }
        },
        {
          "action": {
            "index": 8,
            "node": "S08 取瓶",
            "workflow_node_id": "p03_reagent_pick_s08",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s08",
            "params": {
              "product_type": 3,
              "position": 2
            }
          }
        },
        {
          "action": {
            "index": 9,
            "node": "S09 放料",
            "workflow_node_id": "p03_reagent_place_s09",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s09",
            "params": {
              "product_type": 2,
              "position": 1
            },
            "_comment": "将已开盖液体试剂瓶放到S09液体瓶工位1。"
          }
        },
        {
          "action": {
            "index": 10,
            "node": "S07 粉罐扫码盘点",
            "workflow_node_id": "p02_powder_scan",
            "device_id": "szlab_s07_solid_addition",
            "method": "scan_powder_cartridges",
            "params": {
              "timeout": 300.0
            },
            "_comment": "扫描S07粉罐；后续条件排程器根据位置1、2扫码结果决定是否执行对应的任务27旧粉罐回库节点。"
          }
        },
        {
          "action": {
            "index": 11,
            "node": "S07 替换粉罐旋转到进料位",
            "workflow_node_id": "p02_powder_1_rotate_to_load",
            "device_id": "szlab_s07_solid_addition",
            "method": "rotate_powder_cartridge_to_feed",
            "params": {
              "position": 1,
              "timeout": 300.0
            },
            "_comment": "先执行S07工艺2，将位置1旋转到上下料位；任务27和任务26均不包含旋转。"
          }
        },
        {
          "action": {
            "index": 12,
            "node": "任务27：S072取粉罐并放回S071",
            "workflow_node_id": "p02_powder_1_transfer_s072_to_s071",
            "device_id": "szlab_mixer_robot",
            "method": "submit_transfer_s072_to_s071",
            "params": {
              "product_type": 1,
              "position": "auto"
            },
            "_comment": "旋转到位后，若有旧粉罐则执行任务27；上位机写入S071空位编号。"
          }
        },
        {
          "action": {
            "index": 13,
            "node": "任务26：S071取粉罐并放到S072",
            "workflow_node_id": "p02_powder_1_transfer_s071_to_s072",
            "device_id": "szlab_mixer_robot",
            "method": "submit_transfer_s071_to_s072",
            "params": {
              "position": "1-1"
            },
            "_comment": "第一次上料：旋转完成后执行机器人任务26，从S071位置1-1取粉罐并放到S072。"
          }
        },
        {
          "action": {
            "index": 14,
            "node": "S07 替换粉罐旋转到进料位",
            "workflow_node_id": "p02_powder_2_rotate_to_load",
            "device_id": "szlab_s07_solid_addition",
            "method": "rotate_powder_cartridge_to_feed",
            "params": {
              "position": 2,
              "timeout": 300.0
            },
            "_comment": "先执行S07工艺2，将位置2旋转到上下料位；任务27和任务26均不包含旋转。"
          }
        },
        {
          "action": {
            "index": 15,
            "node": "任务27：S072取粉罐并放回S071",
            "workflow_node_id": "p02_powder_2_transfer_s072_to_s071",
            "device_id": "szlab_mixer_robot",
            "method": "submit_transfer_s072_to_s071",
            "params": {
              "product_type": 1,
              "position": "auto"
            },
            "_comment": "旋转到位后，若有旧粉罐则执行任务27；上位机写入S071空位编号。"
          }
        },
        {
          "action": {
            "index": 16,
            "node": "任务26：S071取粉罐并放到S072",
            "workflow_node_id": "p02_powder_2_transfer_s071_to_s072",
            "device_id": "szlab_mixer_robot",
            "method": "submit_transfer_s071_to_s072",
            "params": {
              "position": "1-1"
            },
            "_comment": "第二次上料：旋转完成后执行机器人任务26，仍从S071位置1-1取粉罐并放到S072。"
          }
        },
        {
          "action": {
            "index": 17,
            "node": "S03 取容器",
            "workflow_node_id": "w01_pick_beaker_s03",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s03",
            "params": {
              "product_type": 1,
              "position": "1-1"
            }
          }
        },
        {
          "action": {
            "index": 18,
            "node": "S072 放料",
            "workflow_node_id": "w01_place_beaker_s072",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s072",
            "params": {
              "product_type": 2,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 19,
            "node": "S07 注粉",
            "workflow_node_id": "w01_dose_powder_s07",
            "device_id": "szlab_s07_solid_addition",
            "method": "dose_powder",
            "params": {
              "coarse_position": 1,
              "fine_position": 1,
              "target_weight": 1.0,
              "timeout": 300.0,
              "recipe_name": "default"
            }
          }
        },
        {
          "action": {
            "index": 20,
            "node": "S072 取料",
            "workflow_node_id": "w02_pick_beaker_s072",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s072",
            "params": {
              "product_type": 2,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 21,
            "node": "S06 放料",
            "workflow_node_id": "w02_place_beaker_s06",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s06",
            "params": {}
          }
        },
        {
          "action": {
            "index": 22,
            "node": "S06 泵加液完整流程：烧杯检测 → 液位确认 → 写入工艺参数 → 等待加工完成",
            "workflow_node_id": "w02_add_solvent_s06",
            "device_id": "szlab_s06_pump",
            "method": "run_solvent_addition",
            "params": {
              "process": 3,
              "volume_pump_1": 10,
              "volume_pump_2": 10,
              "skip_level_check": false,
              "beaker_true_means_present": true
            }
          }
        },
        {
          "action": {
            "index": 23,
            "node": "S06 取料",
            "workflow_node_id": "w03_pick_beaker_s06",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s06",
            "params": {}
          }
        },
        {
          "action": {
            "index": 24,
            "node": "S09 放料",
            "workflow_node_id": "w03_place_beaker_s09",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s09",
            "params": {
              "product_type": 3,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 25,
            "node": "执行 S09 烧杯加液：取 TIP、液体瓶取液、烧杯放液、放 TIP",
            "workflow_node_id": "w03_add_liquid_s09",
            "device_id": "szlab_mixer_pipetting_station",
            "method": "add_liquid_to_beaker",
            "params": {
              "take_tip_box_index": 1,
              "release_tip_box_index": 2,
              "tip_index": 1,
              "liquid_bottle_index": 1,
              "station": 1,
              "aspirate_volume": 5000,
              "dispense_volume": 5000,
              "volume_unit": "raw",
              "skip_level_check": false
            }
          }
        },
        {
          "action": {
            "index": 26,
            "node": "S09 取料",
            "workflow_node_id": "w04_pick_beaker_s09",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s09",
            "params": {
              "product_type": 3,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 27,
            "node": "S04 放料",
            "workflow_node_id": "w04_place_beaker_s04",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s04",
            "params": {
              "position": 1,
              "sample_id": "sample-001"
            }
          }
        },
        {
          "action": {
            "index": 28,
            "node": "执行 S04 磁搅加工",
            "workflow_node_id": "w04_run_stirring_s04",
            "device_id": "szlab_s04_magnetic_stirring",
            "method": "run_stirring",
            "params": {
              "position": 1,
              "mode": 3,
              "speed": 300,
              "temperature": 25,
              "duration": 30.0,
              "safe_temperature": 80,
              "reset": false
            }
          }
        },
        {
          "action": {
            "index": 29,
            "node": "S03 取容器",
            "workflow_node_id": "w05_pick_sample_vial_s03",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s03",
            "params": {
              "product_type": 2,
              "position": "1-1"
            }
          }
        },
        {
          "action": {
            "index": 30,
            "node": "S08 放瓶",
            "workflow_node_id": "w05_place_sample_vial_s08",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s08",
            "params": {
              "product_type": 1,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 31,
            "node": "S08 开/关盖",
            "workflow_node_id": "w05_open_sample_vial_s08",
            "device_id": "szlab_s08_cap_station",
            "method": "process_cap",
            "params": {
              "工艺选择": 3,
              "样品ID": [
                101
              ],
              "瓶盖暂存位": 3,
              "超时时间": 300.0
            }
          }
        },
        {
          "action": {
            "index": 32,
            "node": "S04 取料",
            "workflow_node_id": "w06_pick_beaker_s04",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s04",
            "params": {
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 33,
            "node": "S05 放料",
            "workflow_node_id": "w06_place_beaker_s05",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s05",
            "params": {
              "sample_id": "sample-001"
            }
          }
        },
        {
          "action": {
            "index": 34,
            "node": "执行烧杯姿势拍照检测",
            "workflow_node_id": "w06_take_photo_s05",
            "device_id": "szlab_s05_photoshotting",
            "method": "take_photo",
            "params": {
              "sample_id": "sample-001",
              "photo_path": "",
              "inspection_result": "",
              "require_material": false
            }
          }
        },
        {
          "action": {
            "index": 35,
            "node": "S05 取料",
            "workflow_node_id": "w07_pick_beaker_s05",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s05",
            "params": {
              "sample_id": "sample-001"
            }
          }
        },
        {
          "action": {
            "index": 36,
            "node": "S08 倒料",
            "workflow_node_id": "w07_pour_beaker_s08",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pour_from_s08",
            "params": {
              "product_type": 1
            }
          }
        },
        {
          "action": {
            "index": 37,
            "node": "S11 放成品",
            "workflow_node_id": "w07_place_beaker_s11",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s11",
            "params": {
              "product_type": 1,
              "position": "1-1"
            }
          }
        },
        {
          "action": {
            "index": 38,
            "node": "S08 开/关盖",
            "workflow_node_id": "w07_close_sample_vial_s08",
            "device_id": "szlab_s08_cap_station",
            "method": "process_cap",
            "params": {
              "工艺选择": 4,
              "样品ID": [
                101
              ],
              "瓶盖暂存位": 3,
              "超时时间": 300.0
            }
          }
        },
        {
          "action": {
            "index": 39,
            "node": "S08 取瓶",
            "workflow_node_id": "w07_pick_sample_vial_s08",
            "device_id": "szlab_mixer_robot",
            "method": "submit_pick_from_s08",
            "params": {
              "product_type": 1,
              "position": 1
            }
          }
        },
        {
          "action": {
            "index": 40,
            "node": "S11 放成品",
            "workflow_node_id": "w07_place_sample_vial_s11",
            "device_id": "szlab_mixer_robot",
            "method": "submit_place_to_s11",
            "params": {
              "product_type": 2,
              "position": "1-1"
            }
          }
        }
      ]
    }
  ]
}

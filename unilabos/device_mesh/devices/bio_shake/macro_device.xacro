<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="bio_shake"
    params="parent_link:='' station_name:='' device_name:='' x:=0 y:=0 z:=0 rx:=0 ry:=0 r:=0
            mesh_path:='' width:=0.104 depth:=0.147 height:=0.1159 contact_surface_height:=0.1099">

    <xacro:property name="plate_opening_width" value="0.09"/>
    <xacro:property name="plate_opening_depth" value="0.132"/>
    <xacro:property name="plate_recess_depth" value="0.008"/>
    <xacro:property name="plate_recess_floor_height" value="${height - plate_recess_depth}"/>
    <xacro:property name="plate_side_wall_width" value="${(width - plate_opening_width) / 2.0}"/>
    <xacro:property name="plate_front_back_wall_depth" value="${(depth - plate_opening_depth) / 2.0}"/>
    <xacro:property name="plate_top_edge_height" value="${height - plate_recess_floor_height}"/>

    <!-- Representative fallback envelope for a single-plate INHECO-style thermoshaker.
         Dimensions follow official Thermoshake AC specs: 104 mm W x 147 mm D x 115.9 mm H.
         The SBS plate pickup/drop-off frame is placed at the documented zero-position contact surface. -->
    <joint name="${station_name}${device_name}base_link_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${rx} ${ry} ${r}" />
      <parent link="${parent_link}"/>
      <child link="${station_name}${device_name}device_link"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${station_name}${device_name}device_link"/>
    <joint name="${station_name}${device_name}device_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${station_name}${device_name}device_link"/>
      <child link="${station_name}${device_name}base_link"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${station_name}${device_name}base_link">
      <visual>
        <geometry>
          <mesh filename="file://${mesh_path}/devices/bio_shake/meshes/bio_shake_body.stl"/>
        </geometry>
        <material name="bio_shake_stainless">
          <color rgba="0.83 0.84 0.86 1"/>
        </material>
      </visual>
      <!-- Split the simplified collision so the top-contact plate zone is a genuine open recess. -->
      <!-- <collision>
        <origin xyz="0 0 ${plate_recess_floor_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${depth} ${plate_recess_floor_height}"/>
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="${-(plate_opening_width / 2.0 + plate_side_wall_width / 2.0)} 0 ${plate_recess_floor_height + plate_top_edge_height / 2.0}"
          rpy="0 0 0"/>
        <geometry>
          <box size="${plate_side_wall_width} ${depth} ${plate_top_edge_height}"/>
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="${plate_opening_width / 2.0 + plate_side_wall_width / 2.0} 0 ${plate_recess_floor_height + plate_top_edge_height / 2.0}"
          rpy="0 0 0"/>
        <geometry>
          <box size="${plate_side_wall_width} ${depth} ${plate_top_edge_height}"/>
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="0 ${plate_opening_depth / 2.0 + plate_front_back_wall_depth / 2.0} ${plate_recess_floor_height + plate_top_edge_height / 2.0}"
          rpy="0 0 0"/>
        <geometry>
          <box size="${plate_opening_width} ${plate_front_back_wall_depth} ${plate_top_edge_height}"/>
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="0 ${-(plate_opening_depth / 2.0 + plate_front_back_wall_depth / 2.0)} ${plate_recess_floor_height + plate_top_edge_height / 2.0}"
          rpy="0 0 0"/>
        <geometry>
          <box size="${plate_opening_width} ${plate_front_back_wall_depth} ${plate_top_edge_height}"/>
        </geometry>
      </collision> -->
    </link>

    <!-- Primary robotic access frame for an ANSI/SLAS microplate on the shaker table. -->
    <link name="${station_name}${device_name}socketTypeGenericSbsFootprint"/>
    <joint name="${station_name}${device_name}socketTypeGenericSbsFootprint_1_60_1" type="fixed">
      <parent link="${station_name}${device_name}base_link"/>
      <child link="${station_name}${device_name}socketTypeGenericSbsFootprint"/>
      <origin xyz="0 0 ${contact_surface_height}" rpy="0 0 ${pi / 2.0}"/>
    </joint>

    <!-- Convenience frame that matches the top loading area described by the vendor's zero-position note. -->
    <link name="${station_name}${device_name}plate_slot_access"/>
    <joint name="${station_name}${device_name}plate_slot_access_joint" type="fixed">
      <parent link="${station_name}${device_name}base_link"/>
      <child link="${station_name}${device_name}plate_slot_access"/>
      <origin xyz="0 0 ${contact_surface_height}" rpy="0 0 ${pi / 2.0}"/>
    </joint>

  </xacro:macro>
</robot>
